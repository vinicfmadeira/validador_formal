// DFA — CPF formato ddd.ddd.ddd-dd
digraph dfa_cpf {
	graph [bgcolor=white fontname=Helvetica rankdir=LR]
	node [fontname=Helvetica fontsize=11]
	edge [fontname=Helvetica fontsize=10]
	start [label="" shape=none]
	start -> q0
	q0 [label=q0 shape=circle]
	q1 [label=q1 shape=circle]
	q2 [label=q2 shape=circle]
	q3 [label=q3 shape=circle]
	q4 [label=q4 shape=circle]
	q5 [label=q5 shape=circle]
	q6 [label=q6 shape=circle]
	q7 [label=q7 shape=circle]
	q8 [label=q8 shape=circle]
	q9 [label=q9 shape=circle]
	q10 [label=q10 shape=circle]
	q11 [label=q11 shape=circle]
	q12 [label=q12 shape=circle]
	q13 [label=q13 shape=circle]
	q14 [label=q14 shape=doublecircle]
	qERR [label=qERR fillcolor="#ffcccc" shape=circle style=filled]
	q0 -> q1 [label="0-9"]
	q0 -> qERR [label=outro]
	q1 -> q2 [label="0-9"]
	q1 -> qERR [label=outro]
	q2 -> q3 [label="'.'"]
	q2 -> qERR [label=outro]
	q3 -> q4 [label="0-9"]
	q3 -> qERR [label=outro]
	q4 -> q5 [label="0-9"]
	q4 -> qERR [label=outro]
	q5 -> q6 [label="0-9"]
	q5 -> qERR [label=outro]
	q6 -> q7 [label="0-9"]
	q6 -> qERR [label=outro]
	q7 -> q8 [label="'.'"]
	q7 -> qERR [label=outro]
	q8 -> q9 [label="0-9"]
	q8 -> qERR [label=outro]
	q9 -> q10 [label="0-9"]
	q9 -> qERR [label=outro]
	q10 -> q11 [label="0-9"]
	q10 -> qERR [label=outro]
	q11 -> q12 [label="'-'"]
	q11 -> qERR [label=outro]
	q12 -> q13 [label="0-9"]
	q12 -> qERR [label=outro]
	q13 -> q14 [label="0-9"]
	q13 -> qERR [label=outro]
	qERR -> qERR [label="Σ"]
	q14 -> qERR [label="Σ"]
}
