// MT — L = {w#w | w ∈ {0,1}*}
digraph mt_whasw {
	graph [bgcolor=white fontname=Helvetica nodesep=0.5 rankdir=LR ranksep=0.7]
	node [fontname=Helvetica fontsize=11]
	edge [fontname=Helvetica fontsize=9]
	start [label="" shape=none]
	start -> q0
	q0 [label=q0 shape=circle]
	m0 [label=m0 shape=circle]
	m1 [label=m1 shape=circle]
	n0 [label=n0 shape=circle]
	n1 [label=n1 shape=circle]
	v [label=v shape=circle]
	ret [label=ret shape=circle]
	qACEIT [label=qACEIT shape=doublecircle]
	qREJ [label=qREJ fillcolor="#ffcccc" shape=doublecircle style=filled]
	q0 -> m0 [label="0→X, R"]
	q0 -> m1 [label="1→Y, R"]
	q0 -> v [label="#→#, R"]
	q0 -> q0 [label="X→X,R
Y→Y,R"]
	q0 -> qREJ [label="B→B,S"]
	m0 -> m0 [label="0,1,X,Y→manter,R"]
	m0 -> n0 [label="#→#, R"]
	m0 -> qREJ [label="B→B,S"]
	m1 -> m1 [label="0,1,X,Y→manter,R"]
	m1 -> n1 [label="#→#, R"]
	m1 -> qREJ [label="B→B,S"]
	n0 -> n0 [label="X,Y→manter,R"]
	n0 -> ret [label="0→X, L"]
	n0 -> qREJ [label="1,B,#→manter,S"]
	n1 -> n1 [label="X,Y→manter,R"]
	n1 -> ret [label="1→Y, L"]
	n1 -> qREJ [label="0,B,#→manter,S"]
	ret -> ret [label="0,1,X,Y,#→manter,L"]
	ret -> q0 [label="B→B, R"]
	v -> v [label="X,Y→manter,R"]
	v -> qACEIT [label="B→B,S"]
	v -> qREJ [label="0,1,#→manter,S"]
}
